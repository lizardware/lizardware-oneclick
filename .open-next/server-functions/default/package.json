{
  "name": "lizardware-oneclick",
  "version": "0.5.25",
  "private": true,
  "scripts": {
    "gen:docs": "node scripts/generate-docs.js",
    "dev": "npm run gen:docs && next dev",
    "next:build": "next build",
    "sync:pages": "node scripts/sync-dev-pages.js",
    "build": "npx @opennextjs/cloudflare build",
    "preview": "npm run build && npx wrangler dev --ip 0.0.0.0",
    "preview:clean": "rmdir /s /q .wrangler && npm run preview",
    "deploy": "npm run build && npx wrangler deploy",
    "setup:bindings": "node scripts/setup-bindings.js",
    "db:setup:local": "node scripts/setup-local-db.js",
    "db:migrate:local": "node scripts/migrate-fs-to-d1.js",
    "db:reset": "node scripts/reset-local-db.js",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "prebuild": "node scripts/provision-cloudflare.js && node scripts/init-config.js && node scripts/bundle-migrations.js && node scripts/generate-docs.js",
    "verify:staging": "npm run build && node scripts/verify-staging.js",
    "check": "npm run type-check && npm run lint"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-code-block-lowlight": "^3.13.0",
    "@tiptap/extension-highlight": "^3.14.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/extension-subscript": "^3.14.0",
    "@tiptap/extension-superscript": "^3.14.0",
    "@tiptap/extension-task-item": "^3.14.0",
    "@tiptap/extension-task-list": "^3.14.0",
    "@tiptap/extension-text-align": "^3.14.0",
    "@tiptap/extension-underline": "^3.14.0",
    "@tiptap/markdown": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "base64-js": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.4.1",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.1.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.561.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "svix": "^1.84.1",
    "tailwind-merge": "^3.4.0",
    "zod": "4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "@opennextjs/cloudflare": "^1.17.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.55.0"
  }
}